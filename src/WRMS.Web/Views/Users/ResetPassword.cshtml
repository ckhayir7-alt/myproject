@model WRMS.Web.Models.Users.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="page-header">
    <div>
        <div class="page-eyebrow">Administration</div>
        <h1 class="page-heading">Reset Password</h1>
        <p class="page-subtitle">@Model.FullName &mdash; @Model.Email</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

        <form asp-action="ResetPassword" method="post" novalidate>
            <input type="hidden" asp-for="UserId" />
            <div class="form-section">
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label required-asterisk"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-0">
                    <label asp-for="ConfirmPassword" class="form-label required-asterisk"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-navy"><i class="bi bi-check2 me-1"></i> Reset Password</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
