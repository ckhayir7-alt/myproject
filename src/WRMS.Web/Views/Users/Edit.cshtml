@model WRMS.Web.Models.Users.UserFormViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="page-header">
    <div>
        <div class="page-eyebrow">Administration</div>
        <h1 class="page-heading">Edit User</h1>
        <p class="page-subtitle">Update account details and role assignments.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

        <form asp-action="Edit" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <div class="form-section">
                <div class="form-section-title"><i class="bi bi-person text-muted"></i> Account Details</div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FullName" class="form-label required-asterisk"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label required-asterisk"></label>
                        <input asp-for="Email" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-0">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="Leave blank to keep current password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title"><i class="bi bi-shield-check text-muted"></i> Access</div>
                <div class="mb-3">
                    <label class="form-label required-asterisk">Roles</label>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role" id="role_@role"
                                       checked="@(Model.SelectedRoles.Contains(role))" />
                                <label class="form-check-label" for="role_@role">@role</label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="SelectedRoles" class="text-danger small"></span>
                </div>
                <div class="mb-0 form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-navy"><i class="bi bi-check2 me-1"></i> Save Changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
