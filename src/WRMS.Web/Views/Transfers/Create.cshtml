@model WRMS.Web.Models.Transfers.TransferFormViewModel
@{
    ViewData["Title"] = "Request Ownership Transfer";
}

<div class="page-header">
    <div>
        <div class="page-eyebrow">Registry &bull; Transfer</div>
        <h1 class="page-heading">Request Ownership Transfer</h1>
        <p class="page-subtitle">
            Weapon <strong>@Model.WeaponRegistrationId</strong> &mdash; @Model.WeaponDescription
            &nbsp;&bull;&nbsp; Current Owner: <strong>@Model.CurrentOwnerName</strong>
        </p>
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

<form asp-action="Create" method="post" novalidate>
    <input type="hidden" asp-for="WeaponId" />
    <input type="hidden" asp-for="CurrentOwnerId" />
    <div class="form-section">
        <div class="mb-3">
            <label asp-for="NewOwnerId" class="form-label required-asterisk"></label>
            <select asp-for="NewOwnerId" class="form-select">
                <option value="">-- Select new owner --</option>
                @foreach (var o in Model.Owners)
                {
                    <option value="@o.Id">@o.FullName (@o.OwnerCode)</option>
                }
            </select>
            <span asp-validation-for="NewOwnerId" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Reason" class="form-label required-asterisk"></label>
            <textarea asp-for="Reason" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Reason" class="text-danger small"></span>
        </div>
        <div class="mb-0">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-navy"><i class="bi bi-check2 me-1"></i> Submit Transfer Request</button>
        <a asp-controller="Weapons" asp-action="Details" asp-route-id="@Model.WeaponId" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
