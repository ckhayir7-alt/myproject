@model int
@{
    var (icon, title, message) = Model switch
    {
        404 => ("bi-signpost-2", "Page Not Found", "The page you're looking for doesn't exist or may have been moved."),
        403 => ("bi-shield-exclamation", "Access Denied", "You do not have permission to view this page. This attempt has been logged."),
        429 => ("bi-hourglass-split", "Too Many Requests", "Too many attempts in a short period. Please wait a moment and try again."),
        _ => ("bi-exclamation-triangle", "Something Went Wrong", "An unexpected error occurred while processing your request.")
    };
    ViewData["Title"] = title;
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
}

<div class="d-flex flex-column align-items-center justify-content-center text-center py-5">
    <i class="bi @icon text-danger" style="font-size: 3rem;"></i>
    <h3 class="mt-3">@title</h3>
    <p class="text-muted">@message</p>
    <p class="text-muted small">Status code: @Model</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-navy mt-2">
        <i class="bi bi-house me-1"></i> Return to Home
    </a>
</div>
