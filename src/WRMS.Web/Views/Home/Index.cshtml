@{
    ViewData["Title"] = "Welcome";
}

<div class="d-flex flex-column align-items-center justify-content-center text-center py-5">
    <i class="bi bi-shield-lock-fill" style="font-size: 3rem; color: var(--wrms-navy);"></i>
    <h3 class="mt-3">Weapon Registration &amp; Management System</h3>
    <p class="text-muted">Signed in as <strong>@(User.FindFirst("FullName")?.Value ?? User.Identity?.Name)</strong>.</p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-navy mt-2">
        <i class="bi bi-speedometer2 me-1"></i> Go to Dashboard
    </a>
</div>
