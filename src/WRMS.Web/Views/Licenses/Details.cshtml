@model WRMS.Application.DTOs.Licenses.LicenseDetailDto
@{
    ViewData["Title"] = $"License - {Model.LicenseNumber}";
}

<div class="page-header">
    <div>
        <div class="page-eyebrow">Registry &bull; License</div>
        <h1 class="page-heading">@Model.LicenseNumber <span class="status-badge status-@Model.Status.ToString().ToLowerInvariant() ms-2 align-middle">@Model.Status</span></h1>
        <p class="page-subtitle">
            <a asp-controller="Weapons" asp-action="Details" asp-route-id="@Model.WeaponId">@Model.WeaponRegistrationId</a>
            &mdash; @Model.WeaponDescription (Owner: @Model.OwnerName)
        </p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Officer"))
    {
        <div>
            <a asp-action="Renew" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-arrow-repeat me-1"></i> Renew</a>
            <button type="button" class="btn btn-navy" data-bs-toggle="modal" data-bs-target="#statusModal">
                <i class="bi bi-shield-exclamation me-1"></i> Change Status
            </button>
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">License Details</div>
            <div class="card-body small">
                <dl class="row mb-0">
                    <dt class="col-5">Issue Date</dt><dd class="col-7">@Model.IssueDate.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-5">Expiry Date</dt><dd class="col-7">@Model.ExpiryDate.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-5">Issued By</dt><dd class="col-7">@(Model.IssuedBy ?? "-")</dd>
                </dl>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <hr />
                    <div><strong>Notes</strong><br />@Model.Notes</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">License History</div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead><tr><th>Date</th><th>Action</th><th>Previous Expiry</th><th>New Expiry</th><th>By</th><th>Notes</th></tr></thead>
                    <tbody>
                        @foreach (var h in Model.History)
                        {
                            <tr>
                                <td>@h.ActionDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@h.Action</td>
                                <td>@(h.PreviousExpiryDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td>@(h.NewExpiryDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td>@(h.PerformedByName ?? "-")</td>
                                <td>@(h.Notes ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("Officer"))
{
    <div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-action="SetStatus" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-warning me-2"></i>Change License Status</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label required-asterisk">New Status</label>
                            <select name="status" class="form-select">
                                <option value="@WRMS.Domain.Enums.LicenseStatus.Active">Active</option>
                                <option value="@WRMS.Domain.Enums.LicenseStatus.Suspended">Suspended</option>
                                <option value="@WRMS.Domain.Enums.LicenseStatus.Revoked">Revoked</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Reason / Notes</label>
                            <textarea name="reason" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-navy">Confirm</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}
