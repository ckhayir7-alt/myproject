@model List<WRMS.Application.DTOs.Licenses.LicenseListItemDto>
@{
    ViewData["Title"] = "Licenses";
}

<div class="page-header">
    <div>
        <div class="page-eyebrow">Registry</div>
        <h1 class="page-heading">License Management</h1>
        <p class="page-subtitle">Licenses are issued from an actively registered weapon's detail page.</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <partial name="_EmptyState" model="@(new WRMS.Web.Models.Shared.EmptyStateViewModel {
                Icon = "bi-card-checklist",
                Title = "No licenses issued yet",
                Message = "Licenses will appear here once issued for an actively registered weapon.",
                ActionText = "View Weapon Registrations",
                ActionUrl = Url.Action("Index", "Weapons")
            })" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="licensesTable">
                    <thead>
                        <tr>
                            <th>License Number</th>
                            <th>Weapon</th>
                            <th>Owner</th>
                            <th>Issued</th>
                            <th>Expires</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@l.LicenseNumber</td>
                                <td><a asp-controller="Weapons" asp-action="Details" asp-route-id="@l.WeaponId">@l.WeaponRegistrationId</a> &mdash; @l.WeaponDescription</td>
                                <td>@l.OwnerName</td>
                                <td>@l.IssueDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @l.ExpiryDate.ToString("yyyy-MM-dd")
                                    @if (l.Status == WRMS.Domain.Enums.LicenseStatus.Active && l.DaysUntilExpiry <= 30)
                                    {
                                        <span class="text-danger small">(@l.DaysUntilExpiry d left)</span>
                                    }
                                </td>
                                <td><span class="status-badge status-@l.Status.ToString().ToLowerInvariant()">@l.Status</span></td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@l.Id" class="btn btn-sm btn-outline-secondary" title="View"><i class="bi bi-eye"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            if ($('#licensesTable').length) {
                $('#licensesTable').DataTable({ order: [[4, 'asc']], pageLength: 25 });
            }
        });
    </script>
}
