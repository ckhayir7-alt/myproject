@model WRMS.Web.Models.Licenses.LicenseFormViewModel
@{
    ViewData["Title"] = "Issue License";
}

<div class="page-header">
    <div>
        <div class="page-eyebrow">Registry &bull; License</div>
        <h1 class="page-heading">Issue License</h1>
        <p class="page-subtitle">
            Weapon <strong>@Model.WeaponRegistrationId</strong> &mdash; @Model.WeaponDescription (Owner: @Model.OwnerName)
        </p>
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

<form asp-action="Create" method="post" novalidate>
    <input type="hidden" asp-for="WeaponId" />
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-card-checklist text-muted"></i> License Details</div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="LicenseNumber" class="form-label required-asterisk"></label>
                <input asp-for="LicenseNumber" class="form-control" />
                <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="IssuedBy" class="form-label"></label>
                <input asp-for="IssuedBy" class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="IssueDate" class="form-label required-asterisk"></label>
                <input asp-for="IssueDate" type="date" class="form-control" />
                <span asp-validation-for="IssueDate" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ExpiryDate" class="form-label required-asterisk"></label>
                <input asp-for="ExpiryDate" type="date" class="form-control" />
                <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-0">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-navy"><i class="bi bi-check2 me-1"></i> Issue License</button>
        <a asp-controller="Weapons" asp-action="Details" asp-route-id="@Model.WeaponId" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
