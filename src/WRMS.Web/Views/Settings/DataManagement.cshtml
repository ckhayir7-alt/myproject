@{
    ViewData["Title"] = "Backup & Data Management";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-eyebrow"><i class="bi bi-arrow-left me-1"></i>Back to Settings</a>
        <h1 class="page-heading">Backup &amp; Data Management</h1>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center gap-2"><i class="bi bi-file-earmark-excel text-muted"></i> Data Snapshot Export</div>
    <div class="card-body">
        <p class="text-muted small">
            Download a complete Excel snapshot of all owners, weapons, licenses, and ownership transfers currently on record.
            This export is intended as a portable archival aid and audit reference &mdash; it does not replace regular
            database-level backups, which remain the responsibility of your database administrator.
        </p>
        <a asp-action="ExportSnapshot" class="btn btn-navy"><i class="bi bi-download me-1"></i> Export Full Data Snapshot (Excel)</a>
    </div>
</div>
