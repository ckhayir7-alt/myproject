@model WRMS.Web.Models.Settings.WeaponCategoryFormViewModel
@{
    ViewData["Title"] = "Edit Weapon Category";
}

<div class="page-header">
    <div>
        <a asp-action="Categories" class="page-eyebrow"><i class="bi bi-arrow-left me-1"></i>Back to Categories</a>
        <h1 class="page-heading">Edit Weapon Category</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <form asp-action="EditCategory" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <div class="form-section">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label required-asterisk"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
                <div class="mb-0 form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-navy"><i class="bi bi-check2 me-1"></i> Save Changes</button>
                <a asp-action="Categories" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
