@model WRMS.Web.Models.Weapons.WeaponFormViewModel
@{
    ViewData["Title"] = "Edit Weapon Registration";
}

<div class="page-header">
    <div>
        <div class="page-eyebrow">Registry</div>
        <h1 class="page-heading">Edit Weapon Registration</h1>
        <p class="page-subtitle">Update registration details for this weapon.</p>
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

<form asp-action="Edit" method="post" novalidate>
    <partial name="_Form" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-navy"><i class="bi bi-check2 me-1"></i> Save Changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
