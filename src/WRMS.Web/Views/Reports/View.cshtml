@model WRMS.Application.DTOs.Reports.ReportTableDto
@{
    ViewData["Title"] = Model.Title;
    var type = (WRMS.Application.DTOs.Reports.ReportType)ViewData["ReportType"]!;
    var dateFrom = ViewData["DateFrom"] as string;
    var dateTo = ViewData["DateTo"] as string;
    var supportsDateFilter = type is WRMS.Application.DTOs.Reports.ReportType.WeaponsRegistered
        or WRMS.Application.DTOs.Reports.ReportType.RegistrationActivity
        or WRMS.Application.DTOs.Reports.ReportType.OwnershipTransfers;
}

<div class="page-header no-print">
    <div>
        <a asp-action="Index" class="page-eyebrow"><i class="bi bi-arrow-left me-1"></i>Back to Reports</a>
        <h1 class="page-heading">@Model.Title</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportPdf" asp-route-type="@type" asp-route-dateFrom="@dateFrom" asp-route-dateTo="@dateTo" class="btn btn-outline-secondary">
            <i class="bi bi-file-earmark-pdf me-1"></i> PDF
        </a>
        <a asp-action="ExportExcel" asp-route-type="@type" asp-route-dateFrom="@dateFrom" asp-route-dateTo="@dateTo" class="btn btn-outline-secondary">
            <i class="bi bi-file-earmark-excel me-1"></i> Excel
        </a>
        <button type="button" class="btn btn-navy" onclick="window.print()"><i class="bi bi-printer me-1"></i> Print</button>
    </div>
</div>

@if (supportsDateFilter)
{
    <div class="card mb-3 no-print">
        <div class="card-body">
            <form method="get" asp-action="View" class="row g-2 align-items-end">
                <input type="hidden" name="type" value="@type" />
                <div class="col-md-3">
                    <label class="form-label small">From</label>
                    <input type="date" name="dateFrom" value="@dateFrom" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">To</label>
                    <input type="date" name="dateTo" value="@dateTo" class="form-control" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-navy w-100"><i class="bi bi-funnel"></i> Apply</button>
                </div>
            </form>
        </div>
    </div>
}

<div class="verify-document" style="max-width:100%;">
    <div class="verify-header">
        <h4>@Model.Title</h4>
        <p class="text-muted small mb-0">Weapon Registration &amp; Management System &mdash; Generated @Model.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</p>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-sm" id="reportTable">
            <thead>
                <tr>
                    @foreach (var col in Model.Columns)
                    {
                        <th>@col</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="@Model.Columns.Count" class="text-muted text-center">No records found.</td></tr>
                }
                else
                {
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            @foreach (var cell in row)
                            {
                                <td>@cell</td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            if ($('#reportTable tbody tr').length && $('#reportTable thead th').length) {
                $('#reportTable').DataTable({ pageLength: 25 });
            }
        });
    </script>
}
