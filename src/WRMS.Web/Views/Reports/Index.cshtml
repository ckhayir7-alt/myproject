@{
    ViewData["Title"] = "Reports & Analytics";
    var reports = new (WRMS.Application.DTOs.Reports.ReportType Type, string Title, string Description, string Icon, string Accent)[]
    {
        (WRMS.Application.DTOs.Reports.ReportType.WeaponsRegistered, "Registered Weapons", "Full list of all registered weapons.", "bi-box-seam", "navy"),
        (WRMS.Application.DTOs.Reports.ReportType.LicensesActiveExpired, "Active & Expired Licenses", "Current license status across all weapons.", "bi-card-checklist", "success"),
        (WRMS.Application.DTOs.Reports.ReportType.RegistrationActivity, "Registration Activity", "Registration-related system activity over time.", "bi-activity", "info"),
        (WRMS.Application.DTOs.Reports.ReportType.OwnershipTransfers, "Ownership Transfers", "History of ownership transfer requests and decisions.", "bi-arrow-left-right", "gold"),
        (WRMS.Application.DTOs.Reports.ReportType.SuspendedRevoked, "Suspended & Revoked", "Weapons currently suspended or revoked.", "bi-shield-exclamation", "danger"),
        (WRMS.Application.DTOs.Reports.ReportType.ByLocation, "By Location", "Registration counts grouped by location.", "bi-geo-alt", "teal"),
        (WRMS.Application.DTOs.Reports.ReportType.ByCategory, "By Weapon Category", "Registration counts grouped by category.", "bi-tags", "warning")
    };
}

<div class="page-header">
    <div>
        <div class="page-eyebrow">Insights</div>
        <h1 class="page-heading">Reports &amp; Analytics</h1>
        <p class="page-subtitle">Generate, print, or export official compliance reports.</p>
    </div>
</div>

<div class="row g-3">
    @foreach (var r in reports)
    {
        <div class="col-md-6 col-lg-4">
            <a asp-action="View" asp-route-type="@r.Type" class="card-link">
                <div class="card h-100">
                    <div class="card-body d-flex gap-3 align-items-start">
                        <div class="stat-icon accent-@r.Accent"><i class="bi @r.Icon"></i></div>
                        <div>
                            <div class="fw-semibold text-dark">@r.Title</div>
                            <div class="small text-muted">@r.Description</div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
