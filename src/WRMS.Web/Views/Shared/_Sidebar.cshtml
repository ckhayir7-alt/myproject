@{
    string CurrentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string NavClass(params string[] controllers) =>
        controllers.Any(c => string.Equals(c, CurrentController, StringComparison.OrdinalIgnoreCase))
            ? "nav-link active"
            : "nav-link";
}
<aside class="app-sidebar" id="appSidebar">
    <div class="brand">
        <div class="brand-mark"><i class="bi bi-shield-lock-fill"></i></div>
        <div class="brand-text">
            <div class="brand-title">WRMS</div>
            <div class="brand-subtitle">Registration Authority</div>
        </div>
    </div>

    <nav class="nav flex-column py-2">
        <a class="@NavClass("Dashboard", "Home")" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-speedometer2"></i><span class="nav-label">Dashboard</span><span class="nav-tooltip">Dashboard</span>
        </a>

        <div class="sidebar-section-title">Registry</div>
        <a class="@NavClass("Owners")" asp-controller="Owners" asp-action="Index">
            <i class="bi bi-person-vcard"></i><span class="nav-label">Owners</span><span class="nav-tooltip">Owners</span>
        </a>
        <a class="@NavClass("Weapons")" asp-controller="Weapons" asp-action="Index">
            <i class="bi bi-box-seam"></i><span class="nav-label">Weapon Registrations</span><span class="nav-tooltip">Weapon Registrations</span>
        </a>
        <a class="@NavClass("Licenses")" asp-controller="Licenses" asp-action="Index">
            <i class="bi bi-card-checklist"></i><span class="nav-label">Licenses</span><span class="nav-tooltip">Licenses</span>
        </a>
        <a class="@NavClass("Transfers")" asp-controller="Transfers" asp-action="Index">
            <i class="bi bi-arrow-left-right"></i><span class="nav-label">Ownership Transfers</span><span class="nav-tooltip">Ownership Transfers</span>
        </a>

        <div class="sidebar-section-title">Workflow</div>
        @if (User.IsInRole("Admin") || User.IsInRole("Officer"))
        {
            <a class="@NavClass("Approvals")" asp-controller="Approvals" asp-action="Index">
                <i class="bi bi-check2-square"></i><span class="nav-label">Approval Queue</span><span class="nav-tooltip">Approval Queue</span>
            </a>
        }
        <a class="@NavClass("Search")" asp-controller="Search" asp-action="Index">
            <i class="bi bi-search"></i><span class="nav-label">Search &amp; Verification</span><span class="nav-tooltip">Search &amp; Verification</span>
        </a>

        <div class="sidebar-section-title">Insights</div>
        <a class="@NavClass("Reports")" asp-controller="Reports" asp-action="Index">
            <i class="bi bi-file-earmark-bar-graph"></i><span class="nav-label">Reports &amp; Analytics</span><span class="nav-tooltip">Reports &amp; Analytics</span>
        </a>
        <a class="@NavClass("Notifications")" asp-controller="Notifications" asp-action="Index">
            <i class="bi bi-bell"></i><span class="nav-label">Notifications</span><span class="nav-tooltip">Notifications</span>
        </a>
        @if (User.IsInRole("Admin"))
        {
            <a class="@NavClass("AuditLogs")" asp-controller="AuditLogs" asp-action="Index">
                <i class="bi bi-journal-text"></i><span class="nav-label">Audit Logs</span><span class="nav-tooltip">Audit Logs</span>
            </a>
        }

        @if (User.IsInRole("Admin"))
        {
            <div class="sidebar-section-title">Administration</div>
            <a class="@NavClass("Users")" asp-controller="Users" asp-action="Index">
                <i class="bi bi-people"></i><span class="nav-label">User Management</span><span class="nav-tooltip">User Management</span>
            </a>
            <a class="@NavClass("Settings")" asp-controller="Settings" asp-action="Index">
                <i class="bi bi-gear"></i><span class="nav-label">Settings</span><span class="nav-tooltip">Settings</span>
            </a>
        }
    </nav>

    <button type="button" class="sidebar-collapse-btn" id="sidebarCollapseBtn" aria-label="Collapse sidebar">
        <i class="bi bi-chevron-double-left"></i>
        <span class="collapse-label">Collapse</span>
    </button>
</aside>
