@model WRMS.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_AuthLayout";
}

<div class="mb-4">
    <span class="status-badge status-active mb-2"><i class="bi bi-shield-check me-1"></i>Secure Portal</span>
    <h4 class="mt-2 mb-1">Welcome back</h4>
    <p class="text-muted small mb-0">Sign in with your agency credentials to continue.</p>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

<form asp-action="Login" method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="mb-3">
        <label asp-for="Email" class="form-label required-asterisk"></label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
            <input asp-for="Email" class="form-control" autocomplete="username" autofocus placeholder="you@agency.gov" />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label required-asterisk"></label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
            <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" />
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="mb-4 form-check">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label small"></label>
    </div>

    <button type="submit" class="btn btn-navy w-100">
        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
