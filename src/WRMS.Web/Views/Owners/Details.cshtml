@model WRMS.Application.DTOs.Owners.OwnerDetailDto
@{
    ViewData["Title"] = $"Owner - {Model.FullName}";
}

<div class="page-header">
    <div>
        <div class="page-eyebrow">Registry &bull; Owner</div>
        <h1 class="page-heading">@Model.FullName <span class="status-badge status-@Model.Status.ToString().ToLowerInvariant() ms-2 align-middle">@Model.Status</span></h1>
        <p class="page-subtitle">@Model.OwnerCode</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-pencil me-1"></i> Edit</a>
        @if (User.IsInRole("Admin") || User.IsInRole("Officer"))
        {
            <button type="button" class="btn btn-navy" data-bs-toggle="modal" data-bs-target="#statusModal">
                <i class="bi bi-shield-exclamation me-1"></i> Change Status
            </button>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">Owner Details</div>
            <div class="card-body small">
                <dl class="row mb-0">
                    <dt class="col-5">National ID</dt><dd class="col-7">@Model.NationalId</dd>
                    <dt class="col-5">Date of Birth</dt><dd class="col-7">@Model.DateOfBirth.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-5">Gender</dt><dd class="col-7">@Model.Gender</dd>
                    <dt class="col-5">Phone</dt><dd class="col-7">@Model.PhoneNumber</dd>
                    <dt class="col-5">Address</dt><dd class="col-7">@Model.Address</dd>
                    <dt class="col-5">Occupation</dt><dd class="col-7">@(Model.Occupation ?? "-")</dd>
                    <dt class="col-5">Registered</dt><dd class="col-7">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>
                </dl>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <hr />
                    <div><strong>Notes</strong><br />@Model.Notes</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header">Registered Weapons (@Model.Weapons.Count)</div>
            <div class="card-body p-0">
                @if (Model.Weapons.Count == 0)
                {
                    <p class="text-muted small p-3 mb-0">No weapons registered to this owner.</p>
                }
                else
                {
                    <table class="table mb-0">
                        <thead><tr><th>Registration ID</th><th>Manufacturer</th><th>Model</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var w in Model.Weapons)
                            {
                                <tr>
                                    <td>@w.RegistrationId</td>
                                    <td>@w.Manufacturer</td>
                                    <td>@w.Model</td>
                                    <td><span class="status-badge status-@w.Status.ToString().ToLowerInvariant()">@w.Status</span></td>
                                    <td class="text-end"><a asp-controller="Weapons" asp-action="Details" asp-route-id="@w.Id" class="btn btn-sm btn-outline-secondary">View</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">Supporting Documents</div>
            <div class="card-body">
                @if (Model.Documents.Count > 0)
                {
                    <ul class="list-group mb-3">
                        @foreach (var doc in Model.Documents)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-file-earmark-text me-1"></i> @doc.FileName <span class="text-muted small">(@((doc.FileSizeBytes / 1024.0).ToString("N0")) KB)</span></span>
                                <a asp-action="DownloadDocument" asp-route-documentId="@doc.Id" class="btn btn-sm btn-outline-secondary">Download</a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small">No documents uploaded.</p>
                }

                <form asp-action="UploadDocument" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
                    <input type="hidden" name="ownerId" value="@Model.Id" />
                    <div class="col-md-6">
                        <label class="form-label small">File (PDF, JPG, PNG &mdash; max 10 MB)</label>
                        <input type="file" name="file" class="form-control" required accept=".pdf,.jpg,.jpeg,.png" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Description</label>
                        <input type="text" name="description" class="form-control" maxlength="500" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-navy w-100"><i class="bi bi-upload"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("Officer"))
{
    <div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-action="SetStatus" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-warning me-2"></i>Change Owner Status</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label required-asterisk">New Status</label>
                            <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<WRMS.Domain.Enums.OwnerStatus>()"></select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Reason / Notes</label>
                            <textarea name="reason" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-navy">Confirm</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}
